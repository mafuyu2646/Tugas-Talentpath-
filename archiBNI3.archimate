    <element xsi:type="archimate:BusinessActor" name="Nasabah" id="id-08377ec2e3ed42d58b8cc173efb1523a">
    </element>
    <element xsi:type="archimate:BusinessActor" name="Bank BNI" id="id-bb669b3e6f044efc93053c425d0f64c6">
      <documentation>Asumsi A1: pelaksana proses validasi dan pemrosesan tidak disebut tersurat pada studi kasus.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Pengguna Layanan Digital" id="id-9ff91b88a8d84ae2aabec7e9d1bc71d8">
    </element>
    <element xsi:type="archimate:BusinessRole" name="Penyedia Layanan Perbankan" id="id-5733dbd74a0347ee950ae87ee61c508f">
      <documentation>Asumsi A1: peran yang dipegang Bank BNI pada proses validasi dan pemrosesan.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Akses Layanan" id="id-bfc410458c0a441d8d29686109ea3562">
      <property key="Dukungan SI" value="Didukung sistem informasi"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Verifikasi Identitas" id="id-d73d0c064b6d4a459908fb75348a0aee">
      <property key="Dukungan SI" value="Didukung manual"/>
      <property key="Catatan" value="Asumsi A3"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Input Transaksi" id="id-6d0b809e2fec4c4aac7752a1b2e02f72">
      <property key="Dukungan SI" value="Didukung sistem informasi"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Validasi dan Pemrosesan" id="id-a494c0af385e4c50a306be8f63ff0bba">
      <property key="Dukungan SI" value="Didukung manual"/>
      <property key="Catatan" value="Asumsi A3"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Konfirmasi Transaksi" id="id-6e362f20c3044b42b0a3e183c3f238b8">
      <property key="Dukungan SI" value="Belum didukung"/>
      <property key="Catatan" value="Asumsi A3"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Layanan Perbankan Digital" id="id-2a2f6bcea0554b799499b75acb7d89ee">
    </element>
    <element xsi:type="archimate:BusinessService" name="Layanan Transaksi Digital" id="id-7ff32ab188ec4fd3abc6d4ba5f4ce4a4">
      <documentation>Asumsi A2: layanan dipisah dari Layanan Perbankan Digital agar tahap transaksi punya layanan sendiri.</documentation>
    </element>
